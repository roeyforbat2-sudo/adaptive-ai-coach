# Copy to .env and fill in locally. NEVER commit .env.
# OAuth tokens are NOT stored here; they live in the OS keyring (service: adaptive-ai-coach).

# --- App ---
COACH_ENV=development
COACH_DB_PATH=data/coach.sqlite
COACH_LOG_LEVEL=INFO
# IANA timezone used for local calendar dates.
COACH_TIMEZONE=Asia/Jerusalem
COACH_STORE_RAW=false

# --- LLM (Phase 5) ---
# Prefer storing the key in the keyring (Phase 5 adds a set_key prompt); leave blank here if you do.
ANTHROPIC_API_KEY=
COACH_LLM_MODEL=claude-sonnet-5-5
COACH_LLM_MAX_TOKENS=2000
COACH_DAILY_REVIEW_TIME=06:30

# --- Google Calendar (Phase 6 read-only; Phase 9 write) ---
# Path to the OAuth client JSON downloaded from your Google Cloud project (keep outside the repo or in secrets/).
GOOGLE_OAUTH_CLIENT_FILE=secrets/client_secret.json
GOOGLE_CALENDAR_READ_IDS=primary
# Dedicated calendar for coach-created events; executor refuses any other calendar (Phase 9).
GOOGLE_TRAINING_CALENDAR_ID=
GOOGLE_CALENDAR_WRITE_ENABLED=false

# --- Garmin Connect Personal API (Phase 7) ---
# The personal API key is NOT stored here. It goes into Windows Credential Manager via
#   python -m coach.integrations.garmin.set_key      (local getpass prompt, Phase 7)
# Do not set GARMIN_PERSONAL_API_KEY in this file.
GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com
# Expiry date you chose when creating the key (YYYY-MM-DD); used for UI warnings only.
GARMIN_API_KEY_EXPIRES_ON=
